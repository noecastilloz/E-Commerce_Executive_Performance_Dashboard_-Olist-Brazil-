	partition Dim_Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(Fact_orders[order_purchase_timestamp]),
				        MAX(Fact_orders[order_purchase_timestamp])
				        ),
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "Mes numero", MONTH([Date]),
				    "Año-Mes", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = 2025e6b5fc4d45d482924ab2043ea427

